{
  "name": "edificar-desktop",
  "version": "1.0.0",
  "description": "Edificar Desktop App - Life Church",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg"
  },
  "homepage": "https://portal-lifechurch.com",
  "author": {
    "name": "Edificar Team",
    "email": "suporte@portal-lifechurch.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.edificar.desktop",
    "productName": "Edificar Life Church",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "category": "Office",
      "maintainer": "Edificar Team <suporte@portal-lifechurch.com>"
    }
  }
}
