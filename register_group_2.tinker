        } else { echo "Existing User: {$user->name} ({$user->id})\n"; }
        $exists = \App\Models\UserCommitment::where('user_id', $user->id)->where('package_id', $packageId)->active()->exists();
        if (!$exists) { \App\Models\UserCommitment::create(['user_id' => $user->id, 'package_id' => $packageId, 'committed_amount' => 5000, 'start_date' => now()]); echo "Added commitment for {$user->name}\n"; }
        else { echo "Commitment already exists for {$user->name}\n"; }
    } catch (\Exception $e) { echo "Error registering {$data['name']}: " . $e->getMessage() . "\n"; }
