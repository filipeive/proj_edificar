foreach ($members as $data) {
    try {
        $user = \App\Models\User::where('name', 'like', '%' . $data['name'] . '%')->first();
        if (!$user) {
            $email = \Illuminate\Support\Str::slug($data['name']) . '@edificar.com';
            if (\App\Models\User::where('email', $email)->exists()) { $email = \Illuminate\Support\Str::slug($data['name']) . rand(10,99) . '@edificar.com'; }
            $user = \App\Models\User::create(['name' => $data['name'], 'email' => $email, 'password' => bcrypt('edificar123'), 'phone' => $data['phone'], 'role' => 'membro', 'is_active' => true]);
