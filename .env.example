# ==============================================
# LIFE CHURCH - CONFIGURAÇÃO DO SISTEMA
# ==============================================

# ----------------------------------------------
# APLICAÇÃO
# ----------------------------------------------
APP_NAME="Life Church"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Africa/Maputo

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ----------------------------------------------
# LOGGING
# ----------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------
# IMPORTANTE: Crie o banco de dados antes de rodar migrations
# mysql -u root -p
# CREATE DATABASE nome_do_banco CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=life_church
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------
# SESSÃO E CACHE
# ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# ----------------------------------------------
# FILAS E BROADCAST
# ----------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ----------------------------------------------
# EMAIL (SMTP - Gmail)
# ----------------------------------------------
# Para Gmail:
# 1. Ative a verificação em 2 etapas: https://myaccount.google.com/security
# 2. Gere uma senha de app: https://myaccount.google.com/apppasswords
# 3. Use a senha de app gerada no MAIL_PASSWORD abaixo

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-aqui
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="seu-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------
# REDIS (OPCIONAL)
# ----------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------
# MEMCACHED (OPCIONAL)
# ----------------------------------------------
MEMCACHED_HOST=127.0.0.1

# ----------------------------------------------
# AWS (OPCIONAL)
# ----------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------------
# VITE (BUILD ASSETS)
# ----------------------------------------------
VITE_APP_NAME="${APP_NAME}"
